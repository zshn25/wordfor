# Machine-specific local Rust build config (hardcodes the developer's MinGW paths).
# Must NOT be committed: its [env] CC/AR leak into CI and break macOS/Windows builds.
# See MAINTENANCE.md for the local windows-gnu toolchain setup.
core/.cargo/config.toml
